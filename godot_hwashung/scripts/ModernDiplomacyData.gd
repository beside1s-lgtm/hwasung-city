		for q: Dictionary in pair[2]:
			story2.append("%s → %s. %s" % [q["q"], q["a"][int(q["c"])], q["why"]])
		out.append({"id": pair[0], "name": pair[1], "hanja": "壬午" if pair[0] == "imo" else "甲申", "seal": pair[1].substr(0, 1),
			"hint": "%s 사건을 겪으면 조각이 열립니다." % pair[1], "story": story2})
	return out

static func nation_name(id: String) -> String:
	return String((NATIONS.get(id, {}) as Dictionary).get("name", id))

static func bloc_of(id: String) -> String:
	return String((NATIONS.get(id, {}) as Dictionary).get("bloc", ""))
