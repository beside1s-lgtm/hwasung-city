static func get_random_puzzle(round_num: int) -> Dictionary:
	match round_num:
		1: return PUZZLES_3_PIECES[randi() % PUZZLES_3_PIECES.size()]
		2: return PUZZLES_4_PIECES[randi() % PUZZLES_4_PIECES.size()]
		3: return PUZZLES_5_PIECES[randi() % PUZZLES_5_PIECES.size()]
	return PUZZLES_3_PIECES[0]

## 조각 90도 시계방향 회전
static func rotate_piece_clockwise(piece_matrix: Array) -> Array:
	var rows: int = piece_matrix.size()
	if rows == 0:
		return []
	var cols: int = (piece_matrix[0] as Array).size()
	var rotated: Array = []
	for c: int in range(cols):
		var new_row: Array = []
		for r: int in range(rows - 1, -1, -1):
			new_row.append((piece_matrix[r] as Array)[c])
		rotated.append(new_row)
	return rotated
